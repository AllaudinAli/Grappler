<Window x:Class="Grappler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Grappler.Core"
        Title="Grappler"
        Height="720" Width="1080" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver"
        Activated="OnWindowActivated"
        Closing="OnWindowClosing">

  <Window.Resources>

    <!-- ==========================================================
         THE DOWNLOAD CARD
         ========================================================== -->
    <DataTemplate x:Key="CardTemplate" DataType="{x:Type core:DownloadItem}">
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- thumbnail, with a placeholder until one arrives -->
          <Border Grid.Column="0" Width="112" Height="63" CornerRadius="6"
                  Background="{StaticResource ThumbPlaceholderBrush}"
                  ClipToBounds="True" VerticalAlignment="Center">
            <Grid>
              <Path Data="{StaticResource IconPlay}" Stretch="Uniform"
                    Width="15" Height="15"
                    Fill="{StaticResource ThumbGlyphBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Thumbnail, Converter={StaticResource NullToVis}}" />
              <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                     RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
          </Border>

          <!-- title / meta / status -->
          <Grid Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource TitleText}"
                       Text="{Binding Title}" ToolTip="{Binding Url}" />
            <TextBlock Grid.Row="1" Style="{StaticResource MetaText}"
                       Text="{Binding MetaLine}" Margin="0,3,0,0" />

            <Grid Grid.Row="2" Margin="0,11,0,0">

              <!-- probing / queued / downloading / processing -->
              <Grid x:Name="ActiveRow">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="BarColumn" Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="Bar" Grid.Column="0" Style="{StaticResource Progress}"
                             core:SmoothProgress.Target="{Binding Percent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock Grid.Column="1" Style="{StaticResource NumericText}"
                           Text="{Binding StatusText}" VerticalAlignment="Center" />
              </Grid>

              <!-- ready: details are in, pick a quality -->
              <Grid x:Name="ReadyRow" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="360" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Style="{StaticResource Select}" Height="32"
                          ItemsSource="{Binding Choices}"
                          SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                          ToolTip="Qualities this video actually offers" />
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="32"
                        Padding="14,0" Margin="8,0,0,0" Click="OnDownloadClick">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconDownload}" Style="{StaticResource Icon}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Text="Download" Margin="7,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>

              <!-- done -->
              <StackPanel x:Name="DoneRow" Orientation="Horizontal" Visibility="Collapsed">
                <Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon}"
                      Stroke="{StaticResource SuccessBrush}" StrokeThickness="2.4"
                      Width="12" Height="12" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="7,0,0,0"
                           Foreground="{StaticResource SuccessBrush}" Text="Done" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="9,0,0,0"
                           Text="{Binding SizeText}" />
              </StackPanel>

              <!-- failed / cancelled -->
              <Grid x:Name="FailRow" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconAlert}"
                      Style="{StaticResource Icon}"
                      Stroke="{StaticResource DangerBrush}"
                      Width="13" Height="13" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}"
                           Margin="7,0,0,0" Foreground="{StaticResource DangerBrush}"
                           Text="{Binding ErrorText}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ErrorText}" VerticalAlignment="Center" />
              </Grid>
            </Grid>
          </Grid>

          <!-- per-row actions -->
          <Grid Grid.Column="2" VerticalAlignment="Center">
            <StackPanel x:Name="ActiveActions" Orientation="Horizontal">
              <Button Style="{StaticResource IconButton}" ToolTip="Cancel"
                      Click="OnCancelClick">
                <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Button>
            </StackPanel>

            <StackPanel x:Name="ReadyActions" Orientation="Horizontal" Visibility="Collapsed">
              <Button Style="{StaticResource IconButton}" ToolTip="Remove from the list"
                      Click="OnRemoveClick">
                <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Button>
            </StackPanel>

            <StackPanel x:Name="DoneActions" Orientation="Horizontal" Visibility="Collapsed">
              <Button Style="{StaticResource IconButton}" ToolTip="Show in folder"
                      Click="OnShowInFolderClick">
                <Path Data="{StaticResource IconFolder}" Style="{StaticResource Icon}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Button>
              <Button Style="{StaticResource IconButton}" ToolTip="Play"
                      Click="OnPlayClick">
                <Path Data="{StaticResource IconPlay}" Style="{StaticResource Icon}"
                      Width="13" Height="13"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Stroke="{x:Null}" />
              </Button>
            </StackPanel>

            <StackPanel x:Name="FailActions" Orientation="Horizontal" Visibility="Collapsed">
              <Button Style="{StaticResource IconButton}" ToolTip="Copy the full log"
                      Click="OnCopyLogClick">
                <Path Data="{StaticResource IconCopy}" Style="{StaticResource Icon}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Button>
              <Button Style="{StaticResource IconButton}" ToolTip="Try again"
                      Click="OnRetryClick">
                <Path Data="{StaticResource IconRetry}" Style="{StaticResource Icon}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <DataTemplate.Triggers>
        <!-- A waiting row has no progress to show. Leaving an empty track
             there reads as a download stuck at 0%, so drop the bar and let
             the label take the whole row. -->
        <DataTrigger Binding="{Binding State}" Value="Queued">
          <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="BarColumn" Property="Width" Value="0" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Ready">
          <Setter TargetName="ActiveRow"     Property="Visibility" Value="Collapsed" />
          <Setter TargetName="ReadyRow"      Property="Visibility" Value="Visible" />
          <Setter TargetName="ActiveActions" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="ReadyActions"  Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Done">
          <Setter TargetName="ActiveRow"     Property="Visibility" Value="Collapsed" />
          <Setter TargetName="DoneRow"       Property="Visibility" Value="Visible" />
          <Setter TargetName="ActiveActions" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="DoneActions"   Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Failed">
          <Setter TargetName="ActiveRow"     Property="Visibility" Value="Collapsed" />
          <Setter TargetName="FailRow"       Property="Visibility" Value="Visible" />
          <Setter TargetName="ActiveActions" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="FailActions"   Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Cancelled">
          <Setter TargetName="ActiveRow"     Property="Visibility" Value="Collapsed" />
          <Setter TargetName="FailRow"       Property="Visibility" Value="Visible" />
          <Setter TargetName="ActiveActions" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="FailActions"   Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================================================
         HEADER
         ============================================================ -->
    <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1" Padding="20,16,20,15">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox x:Name="UrlBox" Grid.Column="0" Style="{StaticResource Input}"
                   Tag="Paste a video link, or several at once"
                   KeyDown="OnUrlBoxKeyDown"
                   TextChanged="OnUrlBoxTextChanged" />

          <!-- Fetch first, choose a quality after: the choices come from
               what the video really offers. -->
          <Button x:Name="AddButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                  Content="Fetch" Margin="10,0,0,0" Click="OnAddClick"
                  ToolTip="Read the video's details and available qualities" />

          <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource IconButton}"
                  Width="34" Height="34" Margin="8,0,0,0" ToolTip="Settings"
                  Click="OnSettingsClick">
            <Path Data="{StaticResource IconSettings}" Style="{StaticResource Icon}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,13,0,0">
          <CheckBox x:Name="PlaylistCheck" Style="{StaticResource Check}"
                    VerticalAlignment="Center"
                    Content="Download the whole playlist or channel" />
          <!-- Only worth showing once the playlist box is ticked. -->
          <TextBox x:Name="PlaylistItemsBox" Style="{StaticResource Input}"
                   Height="26" Width="164" Margin="14,0,0,0"
                   Tag="All items - or 1-10, 3,7,12"
                   Visibility="{Binding IsChecked, ElementName=PlaylistCheck, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================================
         FILTER + SORT
         ============================================================ -->
    <Border Grid.Row="1" BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1" Padding="20,10">
      <Grid>
        <Border HorizontalAlignment="Left" CornerRadius="7" Padding="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="SegAll" Style="{StaticResource Segment}"
                         Content="All" IsChecked="True" Checked="OnFilterChanged" />
            <RadioButton x:Name="SegActive" Style="{StaticResource Segment}"
                         Content="Active" Checked="OnFilterChanged" />
            <RadioButton x:Name="SegDone" Style="{StaticResource Segment}"
                         Content="Done" Checked="OnFilterChanged" />
            <RadioButton x:Name="SegFailed" Style="{StaticResource Segment}"
                         Content="Failed" Checked="OnFilterChanged" />
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="DownloadAllButton" Style="{StaticResource PrimaryButton}"
                  Height="30" Padding="14,0" Margin="0,0,12,0" Visibility="Collapsed"
                  Click="OnDownloadAllClick"
                  ToolTip="Download every fetched video at the quality chosen on its row" />
          <TextBox x:Name="SearchBox" Style="{StaticResource Input}"
                   Width="200" Height="30" Tag="Filter by title or link"
                   TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown" />
          <ComboBox x:Name="SortBox" Style="{StaticResource Select}"
                    Width="160" Height="30" Margin="10,0,0,0"
                    SelectionChanged="OnSortChanged" />
          <Button x:Name="ClearFinishedButton" Style="{StaticResource IconButton}"
                  Margin="6,0,0,0" ToolTip="Remove finished rows from the list"
                  Click="OnClearFinishedClick">
            <Path Data="{StaticResource IconTrash}" Style="{StaticResource Icon}"
                  Width="15" Height="15"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================================
         QUEUE
         Pixel-unit virtualisation with container recycling: a 200-item
         queue realises only the rows on screen, and scrolling stays
         smooth rather than snapping card by card.
         ============================================================ -->
    <Grid Grid.Row="2">
      <ItemsControl x:Name="Queue"
                    ItemTemplate="{StaticResource CardTemplate}"
                    Padding="20,16,14,16"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.CacheLength="2"
                    VirtualizingPanel.CacheLengthUnit="Page">
        <ItemsControl.Template>
          <ControlTemplate TargetType="ItemsControl">
            <ScrollViewer CanContentScroll="True" Focusable="False"
                          Padding="{TemplateBinding Padding}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ItemsPresenter />
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- empty state -->
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                  VerticalAlignment="Center" IsHitTestVisible="False"
                  Margin="0,0,0,40"
                  Visibility="{Binding HasItems, ElementName=Queue, Converter={StaticResource NotBoolToVis}}">
        <Border Width="52" Height="52" CornerRadius="26"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                HorizontalAlignment="Center">
          <Path Data="{StaticResource IconLink}" Style="{StaticResource Icon}"
                Stroke="{StaticResource TextTertiaryBrush}" Width="21" Height="21" />
        </Border>
        <TextBlock x:Name="EmptyTitle" Style="{StaticResource BodyText}"
                   Margin="0,16,0,0" HorizontalAlignment="Center"
                   Text="Nothing in the queue" />
        <TextBlock x:Name="EmptyHint" Style="{StaticResource CaptionText}"
                   Margin="0,5,0,0" HorizontalAlignment="Center"
                   Text="Paste a link above and press Fetch, or drop one onto this window" />
      </StackPanel>
    </Grid>

    <!-- ============================================================
         STATUS BAR
         ============================================================ -->
    <Border Grid.Row="3" BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0" Height="36" Padding="20,0">
      <Grid VerticalAlignment="Center">
        <TextBlock x:Name="QueueStatus" Style="{StaticResource CaptionText}"
                   HorizontalAlignment="Left" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <TextBlock x:Name="DiskText" Style="{StaticResource CaptionText}" />
          <Border Width="1" Height="10" Margin="12,0"
                  Background="{StaticResource BorderBrush}" />
          <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
